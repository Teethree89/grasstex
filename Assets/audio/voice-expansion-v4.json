        {"event":"enemyFlanking","file":"voices/us/enemy-flanking-01.mp3","text":"They're trying to flank us!","delivery":"observation"},
        {"event":"enemyFlanking","file":"voices/us/enemy-flanking-02.mp3","text":"They're coming around the side!","delivery":"observation"},
        {"event":"takingFire","file":"voices/us/taking-fire-01.mp3","text":"Taking fire!","delivery":"combat"},
