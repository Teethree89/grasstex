{
  "version": 1,
  "base": "Assets/audio/",
  "format": "mp3",
  "status": "plan: no file exists yet; replaces the Sonniss/Freesound weapon pools and weaponFoley",
  "roster": "battle/modules/53-fbx-soldier-backend.js WEAPON_MODELS: every weapon model listed there must have an entry here",
  "rules": {
    "singleShot": "Every clip with singleShot:true holds exactly one discharge: one onset, attack within the first 10 ms, no second transient above peak-18 dB. Automatic fire is built at runtime by retriggering fire at cyclicRpm with round-robin and no immediate repeat. Recorded bursts are rejected.",
    "tail": "fireTail clips carry the reverb/echo tail only, with no transient. They play once at burst end so short single shots can stay dry.",
    "loudness": "Shots and flybys level on the loudest 100 ms window per MASTERING.md; foley uses the foley target.",
    "keying": "Runtime keys by weapon model (faction + model), not by sim kind, so a Thompson and an M1 Carbine sound different.",
    "voices": "Voice pool per weapon >= ceil(cyclicRpm/60 * maxDurationS) + 2 so a fast MG never steals a playing round.",
    "format": "48 kHz mono source masters kept outside the repo; ship mono MP3, 128 kbps, no leading silence."
  },
